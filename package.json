{
  "name": "@jtgtools/xbeam",
  "version": "0.0.2",
  "description": "Fast Euler-Bernoulli beam FEM solver with chart-ready results",
  "license": "MIT",
  "author": "JTG Tools",
  "keywords": [
    "beam",
    "fem",
    "finite-element",
    "structural-engineering",
    "euler-bernoulli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtgtools/xbeam.git"
  },
  "bugs": {
    "url": "https://github.com/jtgtools/xbeam/issues"
  },
  "homepage": "https://github.com/jtgtools/xbeam#readme",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prepare": "tsup src/index.ts --format esm,cjs --dts --clean",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "demo": "npm run build && npx serve . --listen 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
